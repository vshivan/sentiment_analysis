# ── Python ──────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
*.egg-info/
.env
*.env

# ── Secrets / local config ───────────────────────
backend/.env
frontend/.env
# Keep .env.example files (they are safe to commit)
!**/.env.example

# ── Database (SQLite — never commit the db file) ─
*.db
*.sqlite
*.sqlite3
backend/instance/

# ── Node / Frontend ──────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────
*.log
npm-debug.log*
