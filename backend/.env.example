# ── Required — must be set before starting the server ────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave unset to use SQLite (sqlite:///senti.db)
# Production: set to your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Initial admin account (created on first startup if all three are set) ─────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL to restrict API access
# FRONTEND_URL=https://your-frontend-domain.com

# ── Local dev only ────────────────────────────────────────────────────────────
# DEBUG=true
# PORT=5000
